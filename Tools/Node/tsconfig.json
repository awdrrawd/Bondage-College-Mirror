{
	"compilerOptions": {
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"target": "es2022",
		"lib": ["ES2022"],
		"checkJs": true,
		"allowJs": true,
		"noEmit": true,
		"incremental": true,
		"tsBuildInfoFile": "../../.cache/tsc-tools.tsbuildinfo",
		"strict": true,
		"noImplicitAny": false,
		"skipLibCheck": true,
		"maxNodeModuleJsDepth": 0,
		"types": ["node"]
	},
	"include": [
		"../../Assets/**/*.d.ts",
		"../../Scripts/**/*.d.ts",
		"."
	],
	"exclude": [
		"../../Scripts/MessagesPatch.d.ts",
		"csvtypescript_tmp_output/**/*",
		"TypecheckExpensive.js"
	]
}
