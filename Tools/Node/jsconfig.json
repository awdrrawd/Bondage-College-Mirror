{
	"compilerOptions": {
		"module": "NodeNext",
		"target": "esnext",
		"lib": ["esnext"],
		"moduleResolution": "nodenext",
		"incremental": true,
		"tsBuildInfoFile": "../../.cache/tsc-asset.tsbuildinfo",
		"checkJs": true,
		"strict": true,
		"noImplicitAny": false,
		"skipLibCheck": true
	},
	"include": [
		"../../Assets/**/*.d.ts",
		"../../Scripts/**/*.d.ts",
		".",
	],
	"exclude": [
		"../../Scripts/MessagesPatch.d.ts",
		"csvtypescript_tmp_output/**/*",
		"TypecheckExpensive.js"
	]
}
