{
	"compilerOptions": {
		"module": "commonjs",
		"target": "es2022",
		"lib": ["ES2022", "DOM"],
		"checkJs": true,
		"noEmit": true,
		"types": [],
		"strict": false,
		"skipLibCheck": true,
		"incremental": true,
		"tsBuildInfoFile": "../../.cache/tsc-csvtypescript.tsbuildinfo"
	},
	"include": [
		"../../Scripts/**/*",
		"../../Screens/**/*",
		"../../Assets/**/*",
		"../../Backgrounds/**/*.js",
		"csvtypescript_tmp_output/**/*"
	],
	"exclude": [
		"../../Scripts/lib/**/*.js",
		"../../Scripts/MessagesPatch.d.ts",
		"../../Scripts/DeclarationsExpensive.d.ts",
		"../../Scripts/DeclarationsStatic.d.ts",
		"../../Screens/MiniGame/KinkyDungeonPublic.d.ts"
	]
}
