		"tsBuildInfoFile": "../../.cache/tsc-expensive.tsbuildinfo",
		"module": "commonjs",
		"target": "es2022",
		"lib": ["ES2022", "DOM"],
		"allowJs": true,
		"strict": true,
		"noImplicitAny": true
	},
	"include": [
		"../../Scripts/**/*",
