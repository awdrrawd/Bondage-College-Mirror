{
	"name": "bondage-college",
	"version": "1.0.0",
	"description": "Welcome to the Bondage College!",
	"engines": {
		"node": ">= 26.13.0"
	},
	"scripts": {
		"changelog:generate": "cd Tools/Node && node GenerateChangelog generate",
		"changelog:prepare": "cd Tools/Node && node GenerateChangelog prepare",
		"checks": "node --unhandled-rejections=strict Tools/Node/Checks.js --cheap",
		"checks:cheap": "node --unhandled-rejections=strict Tools/Node/Checks.js --cheap",
		"checks:expensive": "node --unhandled-rejections=strict Tools/Node/Checks.js",
		"assets:checks": "run-p -cs --aggregate-output assets:check assets:lint",
		"assets:clean": "gulp --gulpfile Tools/Node/gulpfile.js clean",
		"assets:minify": "gulp --gulpfile Tools/Node/gulpfile.js assetMinify --max-old-space-size=8192",
		"assets:prettier": "prettier --check Assets/Female3DCG.js Assets/Female3DCGExtended.js",
		"assets:prettier:fix": "prettier --write Assets/Female3DCG.js Assets/Female3DCGExtended.js",
		"assets:eslint": "eslint --cache --cache-location .cache/eslint Assets/Female3DCG.js Assets/Female3DCGExtended.js",
		"assets:lint": "run-s -cn assets:prettier assets:eslint",
		"assets:lint:fix": "prettier-eslint --write Assets/Female3DCG.js Assets/Female3DCGExtended.js",
		"assets:check": "cd Tools/Node && node --unhandled-rejections=strict AssetCheck",
		"assets:posemapping": "cd Tools/Node && node --unhandled-rejections=strict PoseMapping",
		"scripts:lint": "eslint --cache --cache-location .cache/eslint \"Scripts/**/*.js\" \"Screens/**/*.js\" \"Tools/**/*.js\" \"Backgrounds/Backgrounds.js\"",
		"scripts:lint:fix": "eslint --cache --cache-location .cache/eslint --fix \"Scripts/**/*.js\" \"Screens/**/*.js\" \"Tools/**/*.js\" \"Backgrounds/Backgrounds.js\"",
		"tools:typecheck": "tsc -p Tools/Node",
		"scripts:typecheck": "run-p -cs --aggregate-output scripts:typecheck:bc scripts:typecheck:kd",
		"scripts:typecheck:bc": "tsc -p tsconfig.json",
		"scripts:typecheck:kd": "tsc -p Screens/MiniGame/KinkyDungeon/tsconfig.json",
		"scripts:typecheck-expensive": "tsc -p tsconfig.expensive.json",
		"styles:prettier": "prettier --check --print-width 120 CSS/",
		"styles:prettier:fix": "prettier --write --print-width 120 CSS/",
		"files:case": "cd Tools/Node && node --unhandled-rejections=strict FileCase",
		"files:sortcsv": "cd Tools/Node && node --unhandled-rejections=strict SortCSV",
		"files:csvtypescript": "cd Tools/Node && node --unhandled-rejections=strict CSVTypescript && cd ../../.. && tsc -p BondageClub/tsconfig.csvtypescript.json",
		"files:csvtypescript:unstable": "cd Tools/Node && node --unhandled-rejections=strict CSVTypescript -l && cd ../../.. && tsc -p BondageClub/tsconfig.csvtypescript.json",
		"test": "jest --onlyFailures",
		"tests:lint": "eslint --cache --cache-location .cache/eslint \"Tests/**\"",
		"tests:lint:fix": "eslint --cache --cache-location .cache/eslint --fix \"Tests/**\""
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Ben987/Bondage-College.git"
	},
	"author": "Ben987 <30805159+Ben987@users.noreply.github.com>",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/Ben987/Bondage-College/issues"
	},
	"homepage": "https://github.com/Ben987/Bondage-College#readme",
	"browserslist": [
		"since 2020 and > 0.5% and not dead",
		"Firefox >= 115",
		"Chrome >= 109"
	],
	"devDependencies": {
		"@babel/preset-env": "^7.29.7",
		"@babel/preset-typescript": "^7.29.7",
		"@eslint/js": "^10.0.1",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/core-js": "^2.5.8",
		"@types/fancy-log": "^2.0.2",
		"@types/gulp": "^4.0.17",
		"@types/gulp-cache": "^0.4.9",
		"@types/gulp-filter": "^3.0.39",
		"@types/gulp-imagemin": "^8.0.6",
		"@types/gulp-match": "^1.1.6",
		"@types/gulp-size": "^4.0.3",
		"@types/imagemin-jpegtran": "^5.0.4",
		"@types/jest": "^30.0.0",
		"@types/jsdom": "^30.0.0",
		"@types/lodash.template": "^4.5.3",
		"@types/minimist": "^1.2.5",
		"@types/node": "^26.6.5",
		"@types/stream-counter": "^1.0.3",
		"ansi-colors": "^4.1.1",
		"canvas": "^3.1.0",
		"cheerio": "^1.2.0",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-compat": "^7.0.2",
		"eslint-plugin-jsdoc": "^65.4.2",
		"eslint-plugin-no-unsanitized": "^4.1.5",
		"eslint-plugin-sort-keys-custom": "^2.0.0",
		"fancy-log": "^2.0.0",
		"globals": "^17.13.0",
		"gulp": "^5.0.1",
		"gulp-cache": "^1.1.3",
		"gulp-count": "^1.0.0",
		"gulp-filter": "^10.0.0",
		"gulp-if": "^3.0.0",
		"gulp-imagemin": "^9.2.0",
		"gulp-size": "^5.0.0",
		"imagemin-jpegtran": "^8.0.0",
		"jest": "^30.5.2",
		"jest-environment-jsdom": "^30.5.2",
		"jest-expect-message": "^1.1.3",
		"jest-extended": "^7.0.0",
		"marked": "^18.1.2",
		"minimist": "^1.2.6",
		"npm-run-all": "^4.1.5",
		"prettier": "^3.9.10",
		"prettier-eslint": "^17.1.2",
		"prettier-eslint-cli": "^9.2.1",
		"pretty-bytes": "^7.2.0",
		"rimraf": "^6.1.3",
		"simple-git": "^4.0.2",
		"stream-counter": "^1.0.0",
		"table": "^6.7.3",
		"through2": "^5.0.12",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1"
	},
	"dependencies": {
		"csv-writer": "^1.6.0",
		"pixi-filters": "^5.2.1",
		"pixi.js-legacy": "^6.4.2",
		"socket.io-client": "^4.8.4"
	}
}
